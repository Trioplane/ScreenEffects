{
    "name": "ScreenEffects",
    "description": "A small flexible library for showing animated screen overlays to the user.",
    "version": "v3.0.0-beta",
    "author": "Trplnr",
    "require": ["bolt"],
    "minecraft": "1.21.10",
    "data_pack": {
      "load": ["./src"],
      "min_format": [88,0],
      "max_format": [88,0]
    },
    "resource_pack": {
      "load": ["./src"],
      "min_format": [69,0],
      "max_format": [69,0]
    },
    "pipeline": ["mecha"],
    "output": "./build",
    "meta": {
      "bolt": {"entrypoint": ["scrfx:*", "example:*", "test:*"]}
    }
}